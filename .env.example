# Copy this file to .env.local for local testing, and add the same values
# in Vercel > Project > Settings > Environment Variables. See SETUP.md.

# Google Gemini (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Optional: used automatically when the main model is overloaded
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Telegram bot from @BotFather, and your own chat id (the bot tells you with /start)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Any long random string
TELEGRAM_WEBHOOK_SECRET=

# Upstash Redis (free): https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# LinkedIn developer app: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional. Leave empty to use a recent version automatically (format YYYYMM).
LINKEDIN_VERSION=

# Any long random strings
ADMIN_SECRET=
CRON_SECRET=

# Optional on Vercel (found automatically). Needed only if you use a custom domain.
APP_URL=
